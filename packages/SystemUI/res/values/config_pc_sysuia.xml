<resources>
    <!-- Whether the status bar media chip shows the app icon and the title of what is playing,
         with the play/pause button in place of the icon while the pointer is over the chip,
         instead of the play/pause button and a waveform. -->
    <bool name="config_statusBarMediaChipShowsTitle">false</bool>

    <!-- Whether heads-up notifications on the desktop status bar are fully rounded and keep their
         header while they float over the screen: pinned, animating away, or pulled down. -->
    <bool name="config_desktopHeadsUpAppearance">false</bool>

    <!-- Whether the dismiss button of a notification can also be reached by keyboard focus and
         accessibility services, and shows while the focus is on the notification. -->
    <bool name="config_notificationDismissButtonAccessible">false</bool>

    <!-- Whether the notification list scrolls when a notification at its bottom is expanded, so
         that the expanded notification stays in view. -->
    <bool name="config_scrollShadeOnBottomNotificationExpand">false</bool>

    <!-- Whether the desktop status bar shows the notifications chip next to the clock, with the
         icons of the notifying apps, instead of a bell at the end next to quick settings. A click
         on it opens the notifications shade. -->
    <bool name="config_desktopStatusBarNotificationsAtStart">false</bool>

    <!-- Whether the notifications shade overlay draws its own empty state ("You're all caught
         up") instead of leaving it to the notification stack, in the dual shade. -->
    <bool name="config_composeEmptyNotificationShade">false</bool>

    <!-- Whether heads-up notifications are cards at the top end of the screen, as on desktop
         systems, while the notifications popup is closed: each shows for
         config_desktopHeadsUpTimeoutMs and leaves (none stays, calls and sticky ones included);
         the pointer over it, expanding it, replying or its settings restart that time once.
         Several stack one below the other, at most config_desktopHeadsUpMaxCards, the oldest
         leaving first. Each one stays in the notifications list. -->
    <bool name="config_desktopHeadsUpCards">false</bool>
    <integer name="config_desktopHeadsUpTimeoutMs">20000</integer>
    <integer name="config_desktopHeadsUpMaxCards">4</integer>

    <!-- Whether the shade window (its popups and heads-up notifications) also goes to the display
         that gets the focus, besides the one whose status bar was touched. -->
    <bool name="config_shadeFollowsFocusedDisplay">false</bool>
</resources>
