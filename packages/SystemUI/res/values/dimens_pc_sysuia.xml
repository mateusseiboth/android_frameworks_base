<resources>
    <!-- Status bar media chip showing a title (config_statusBarMediaChipShowsTitle). -->
    <!-- Size of the app icon and of the play/pause button; scales with the font size. -->
    <dimen name="status_bar_media_chip_icon_size">18sp</dimen>
    <!-- Narrowest and widest the chip gets, whatever the length of the title. -->
    <dimen name="status_bar_media_chip_min_width">46dp</dimen>
    <dimen name="status_bar_media_chip_max_width">140dp</dimen>
    <!-- Length of the fade on the edges of a title that does not fit. -->
    <dimen name="status_bar_media_chip_text_fading_edge_length">12sp</dimen>

    <!-- Heads-up cards at the top end of the screen (config_desktopHeadsUpCards): their margin
         below the status bar, and the gap between stacked cards. -->
    <dimen name="desktop_heads_up_card_margin_top">8dp</dimen>
    <dimen name="desktop_heads_up_card_gap">8dp</dimen>
</resources>
