<resources>
    <!-- Whether desktop windows never enter the "full immersive" state (fullscreen bounds with
         the header hidden under the status bar). When true, an immersive app keeps its header
         when maximized and the layout menu does not offer the immersive option. -->
    <bool name="config_disableDesktopFullImmersive">false</bool>

    <!-- Whether the fullscreen header slides down from the top edge when shown and back up when
         hidden, instead of appearing and disappearing at once. -->
    <bool name="config_animateFullscreenHeader">false</bool>

    <!-- Whether split-screen tasks of a desktop-first display get the fullscreen header (app chip,
         exit and close) like fullscreen tasks, instead of the app handle. -->
    <bool name="config_showFullscreenHeaderInSplitScreen">false</bool>

    <!-- Whether an app that draws its own caption (transparent caption bar appearance, such as a
         browser tab strip) keeps it under the fullscreen header of a desktop-first display: the
         header turns transparent and gives the app the caption insets, as in a desktop window. -->
    <bool name="config_keepCustomHeaderInFullscreen">false</bool>

    <!-- Whether window headers show the label and icon an app sets on its task description, and
         update them when the app changes it, instead of its launch activity's label and icon. -->
    <bool name="config_windowHeaderFollowsTaskDescription">false</bool>

    <!-- Apps whose window headers follow their task description when
         config_windowHeaderFollowsTaskDescription is true. Empty means every app. -->
    <string-array name="config_windowHeaderTaskDescriptionPackages" translatable="false" />
</resources>
