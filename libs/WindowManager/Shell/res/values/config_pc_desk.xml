<!-- Desktop window behaviors of PC builds. All off by default, turned on by a device overlay. -->
<resources>
    <!-- Whether a desktop window that back navigation closes stays in its desk as a minimized
         window (restored from the taskbar by relaunching it) instead of leaving the desk. -->
    <bool name="config_minimizeDesktopWindowOnBackClose">false</bool>

    <!-- Whether the bounds of a window snapped to half of the screen are left out of the
         remembered launch bounds of its app, so a relaunch opens it at its last free size. -->
    <bool name="config_excludeTiledBoundsFromRememberedBounds">false</bool>

    <!-- Whether Home takes the input focus while the home screen is peeked, so keyboard input
         reaches the launcher; the top desktop window takes it back when the peek ends. -->
    <bool name="config_focusHomeWhilePeeking">false</bool>

    <!-- Whether the desktop windows come back in the stacking order they had when the desktop
         was left (Home, Overview, a fullscreen app) once it is entered again. -->
    <bool name="config_preserveDesktopZOrderOnExit">false</bool>

    <!-- Whether, on a desktop-first display that shows Home behind the desktop, the desk stays
         active and empty when its last window closes, so the next app opens as a window. -->
    <bool name="config_keepEmptyDeskActiveShowingHome">false</bool>
</resources>
